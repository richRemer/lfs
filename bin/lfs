#!/bin/bash -e

declare tmpdir=$(mktemp -d); trap "rm -rf $tmpdir" EXIT
declare script=$(realpath "$0")
declare bin=$(dirname "$script")
declare root=$(dirname "$bin")
declare lib="$root/lib/lfs"
declare action=
declare -i chk_ok=0 chk_failed=0

# chk.failed
# Report a failed test.
chk.failed () {
    chk_failed=$((chk_failed+1))
    echo -e '\x1b[33mfailed\x1b[0m'
}

# chk.fatal
# Report a failed test and generate an error.
chk.fatal () {
    chk.failed
    fatal "critical check failed"
}

# chk.ok
# Report a successful test.
chk.ok () {
    chk_ok=$((chk_ok+1))
    echo -e '\x1b[32mok\x1b[0m'
}

# chk.test <title>
# Display title for a test about to be run.  Should call chk.ok, chk.failed,
# or chk.fatal after running the test.
chk.test () {
    local result

    case "$1" in
        --ok)       result=chk.ok; shift;;
        --failed)   result=chk.failed; shift;;
    esac

    echo -n " * $1 "
    if test "$result"; then $result; fi
}

# chk.title <title>
# Display title for a series of tests about to be run.
chk.title () {
    echo "$1"
}

# chk.ver <name> <cmd> <version>
# Check package version by calling command with --version option.
chk.ver () {
    local ver
    chk.test "$1 $3"

    if ! type -p "$2" &>/dev/null; then
        chk.failed
        return
    fi

    ver=$($2 --version |& grep -E -o '[0-9]+\.[0-9\.]+[a-z]*' | head -n1)
    if printf '%s\n' $3 $ver | sort --version-sort --check &>/dev/null; then
        chk.ok
    else
        chk.failed
    fi
}

# enoarg <arg>
# Generate an error for a missing argument.
enoarg () {
    fatal "missing argument: $1"
}

# einvarg <arg>
# Generate an error for an invalid or unexpected argument.
einvarg () {
    fatal "unexpected argument: $1"
}

# err <msg>
# Print an error message.
err () {
    local act="${action:+ $action}"
    echo "$(basename "$script")$act: $1" >&2
}

# fatal <msg>
# Print an error message and return an error.
fatal () {
    err "$1"
    return 1
}

# create-disk [--format=<fs>] <mb> <file>
# Create a disk image and optionally format it.
lfs.create-disk () {
    local format

    case "$1" in
        --format)   format="$2"; shift 2 || enoarg "fs type";;
        --format=*) format="${1#*=}"; shift;;
    esac

    local -i size="$1"; shift || enoarg "size"
    local file="$1"; shift || enoarg "file"

    dd if=/dev/zero of="$file" bs=1M count=$size

    if test "$format"; then
        mkfs."$format" "$file"
    fi
}

# create-user <username>
# Create the LFS user account.
lfs.create-user () {
    local username="$1"; shift || enoarg username
    useradd -rms /bin/bash -b /var/lib -k "$lib/skel" "$username"
}

# fetch <url> <md5>
# Fetch a remote resource.
lfs.fetch () {
    local tmp=$(mktemp $tmpdir/fetch.XXXX)
    local name=$(basename "$1")
    local sum

    wget -qO$tmp "$1"
    sum=$(md5sum $tmp | cut -d" " -f1)

    if test "$sum" != "$2"; then
        echo "failed to fetch $1" >&2
        echo "  MD5 checksum expected: $2" >&2
        echo "  MD5 checksum actual:   $sum [$name]" >&2

        return 1
    fi

    mv $tmp ./$name
}

# list-actions
# List known actions.
lfs.list-actions () {
    declare -F | cut -d" " -f3 | grep 'lfs\.' | sed -e s/^lfs.//
}

# mkroot <dir>
# Setup root filesystem in directory.
lfs.mkroot () {
    local root="$1"; shift || enoarg "root dir"

    (
        umask 022
        mkdir -p "$root"
        cd "$root"

        mkdir boot dev media mnt opt proc run srv sys tmp
        mkdir -p etc/{opt,skel}
        mkdir -p var/{cache,games,lib/misc,local,log,mail,opt,spool,tmp}
        mkdir -p usr/{bin,include,lib/modules,libexec,src}
        mkdir -p usr/local/{bin,etc,games,include,lib,man,src}
        mkdir -p usr/{local/,}share/{color/icc,dict,man/man{1,2,3,4,5,6,7,8},misc}

        chmod ugo+rwx tmp var/tmp
        chmod o+t tmp
        chmod ugo-w proc sys

        ln -s ../proc/self/mounts etc/mtab
        ln -s bin usr/sbin
        ln -s bin usr/local/sbin
        ln -s usr/bin
        ln -s usr/lib
        ln -s usr/sbin
        ln -s /run var/run
        ln -s /run/lock var/lock
    )
}

# verify-host
# Verify host has everything it needs to build LFS system.
lfs.verify-host () {
    chk.title "checking for core dependencies"
    chk.test grep; grep --version &>/dev/null && chk.ok || chk.fatal
    chk.test sed; sed '' /dev/null && chk.ok || chk.fatal
    chk.test sort; sort /dev/null && chk.ok || chk.fatal

    chk.title "identifying coreutils vendor"
    case $(vendor) in
        uutils) chk.test --ok uutils;;
        GNU)    chk.test --ok GNU;;
        *)      chk.test --failed unknown;;
    esac

    chk.title "checking versions"
    case $(vendor) in
        uutils) chk.ver Coreutils sort 0.8;;
        GNU)    chk.ver Coreutils sort 8.1;;
    esac

    chk.ver Bash         bash     3.2
    chk.ver Binutils     ld       2.13.1
    chk.ver Bison        bison    2.7
    chk.ver Diffutils    diff     2.8.1
    chk.ver Findutils    find     4.2.31
    chk.ver Gawk         gawk     4.0.1
    chk.ver GCC          gcc      5.4
    chk.ver "GCC (C++)"  g++      5.4
    chk.ver Grep         grep     2.5.1a
    chk.ver Gzip         gzip     1.3.12
    chk.ver M4           m4       1.4.10
    chk.ver Make         make     4.0
    chk.ver Patch        patch    2.5.4
    chk.ver Perl         perl     5.8.8
    chk.ver Python       python3  3.4
    chk.ver Sed          sed      4.1.5
    chk.ver Tar          tar      1.22
    chk.ver Texinfo      texi2any 5.0
    chk.ver Xz           xz       5.0.0

    echo $chk_ok 'test(s) passed'
    if test $chk_failed -gt 0; then
        echo $chk_failed 'test(s) failed' >&2
        return 1
    fi
}

# vendor
# Print the Coreutils vendor for this system.
vendor () {
    sort --version |& grep -q uutils && echo uutils || echo GNU
}

action="$1"; shift || enoarg "action (try '$(basename "$script") list-actions')"

if ! test "$(type -t "lfs.$action")" = function; then
    einvarg "$action"
fi

lfs.$action "$@"; exit
